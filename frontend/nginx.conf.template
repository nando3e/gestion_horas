server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Enviar todos los recursos estáticos con su ubicación exacta
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg)$ {
        expires max;
        try_files $uri =404;
    }

    # index.html siempre se revalida: si se queda en caché, el navegador sigue
    # cargando el bundle de la versión anterior tras un despliegue
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # Proxy para la API - Usa variables de entorno
    location /api/ {
        proxy_pass http://${API_SERVICE_NAME}:${API_PORT};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }

    # Para todas las demás rutas, servir index.html (enrutamiento SPA)
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Configuración de errores
    error_page 404 /index.html;
    error_page 500 502 503 504 /index.html;
}
